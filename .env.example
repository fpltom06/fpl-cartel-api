# Relative to the API project directory. Only precomputed, clean projection output.
PROJECTIONS_PATH=data/projections.json
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Deployment: ALLOWED_ORIGINS= (blank) denies all browser origins initially.
# Later set the exact HTTPS Netlify origin; multiple origins are comma-separated; never use *.
FPL_BASE_URL=https://fantasy.premierleague.com/api/
FPL_METADATA_TTL=300
FPL_MANAGER_TTL=60
FPL_TIMEOUT_SECONDS=10
MAX_REQUEST_BYTES=16384
MAX_OPTIMIZER_CONCURRENCY=1

